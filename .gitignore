# =============================================================================
# .gitignore — "مدارس ومعاهد نمبر ون"
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Virtual Environment ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ─── Environment Variables (أسرار — لا تُرفع أبداً) ─────────────────────────
.env
.env.local
.env.production
.env.*.local
# الملف المرجعي الآمن (بدون قيم حقيقية) يُرفع:
# .env.example ← مسموح به

# ─── Django ──────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
staticfiles/        # مُنشأ بواسطة collectstatic — لا تُرفع
media/              # ملفات مرفوعة — لا تُرفع في Git
*.log

# ─── Backups (ملفات النسخ الاحتياطية المحلية) ───────────────────────────────
backups_storage/

# ─── Node.js / React ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/      # مُنشأ أثناء Build — لا تُرفع

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── IDEs ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Render / Deployment ─────────────────────────────────────────────────────
# render.yaml يُرفع (IaC عام)
# build.sh يُرفع

# ─── Patch / Seed Scripts المؤقتة ────────────────────────────────────────────
# يمكن رفعها إذا لزم الأمر، أو إضافتها هنا لاستبعادها:
# patch_students.py
# patch_students_crud.py
# seed_data.py
