# =============================================================================
# .gitignore — "مدارس ومعاهد نمبر ون"
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Virtual Environment ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ─── Environment Variables (أسرار — لا تُرفع أبداً) ─────────────────────────
.env
.env.local
.env.production
.env.*.local
# الملف المرجعي الآمن (بدون قيم حقيقية) يُرفع:
# .env.example ← مسموح به

# ─── Django ──────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
staticfiles/        # مُنشأ بواسطة collectstatic — لا تُرفع
media/              # ملفات مرفوعة — لا تُرفع في Git
*.log

# ─── Backups (ملفات النسخ الاحتياطية المحلية) ───────────────────────────────
backups_storage/

# ─── Node.js / React ─────────────────────────────────────────────────────────
frontend/node_modules/


# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── IDEs ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Render / Deployment ─────────────────────────────────────────────────────
# render.yaml يُرفع (IaC عام)
# build.sh يُرفع

# ─── Patch / Seed Scripts المؤقتة ────────────────────────────────────────────
# يمكن رفعها إذا لزم الأمر، أو إضافتها هنا لاستبعادها:
# patch_students.py
# patch_students_crud.py
# seed_data.py

# ─── Mobile Client ───────────────────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/dist/

# ── مفاتيح توقيع التطبيق — لا تُرفع إلى git إطلاقاً ─────────────────────────
# فقدان هذا المفتاح أو تسريبه لا يمكن التراجع عنه: من يملكه يستطيع توقيع
# تحديثات تبدو صادرة منك، وفقدانه يمنعك من تحديث التطبيق على المتجر نهائياً.
*.jks
*.keystore
!mobile/android/app/debug.keystore
*.p12
*.pepk
credentials.json
