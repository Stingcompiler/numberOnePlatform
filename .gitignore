# =============================================================================
# .gitignore — "مدارس ومعاهد نمبر ون"
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Virtual Environment ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ─── Environment Variables (أسرار — لا تُرفع أبداً) ─────────────────────────
.env
.env.local
.env.production
.env.*.local
# الملف المرجعي الآمن (بدون قيم حقيقية) يُرفع:
# .env.example ← مسموح به

# ─── Django ──────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
staticfiles/        # مُنشأ بواسطة collectstatic — لا تُرفع
# ملفات مرفوعة — لا تُرفع في Git
# (التعليق على سطر مستقل: gitignore لا يعامل ما بعد # على نفس
#  السطر كتعليق، فكانت القاعدة نمطاً حرفياً لا يطابق شيئاً)
media/
*.log

# ─── Backups (ملفات النسخ الاحتياطية المحلية) ───────────────────────────────
backups_storage/

# ─── Node.js / React ─────────────────────────────────────────────────────────
frontend/node_modules/


# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ─── IDEs ────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Render / Deployment ─────────────────────────────────────────────────────
# render.yaml يُرفع (IaC عام)
# build.sh يُرفع

# ─── Patch / Seed Scripts المؤقتة ────────────────────────────────────────────
# يمكن رفعها إذا لزم الأمر، أو إضافتها هنا لاستبعادها:
# patch_students.py
# patch_students_crud.py
# seed_data.py

# ─── Mobile Client ───────────────────────────────────────────────────────────
mobile/node_modules/
mobile/.expo/
mobile/dist/

# ─── مفاتيح التوقيع ──────────────────────────────────────────────────────────
# لا يدخل مفتاح توقيع مستودعاً أبداً. أنزل EAS ملف @singspp__n1.jks إلى mobile/
# أثناء عملية اعتمادات، فابتلعه `git add -A` ووصل إلى الطرف البعيد. استثناء
# debug.keystore وحده: مفتاح تطوير قياسي كلمة مروره `android` معروفة للجميع،
# ووجوده في المستودع هو العُرف.
*.jks
*.keystore
*.p12
*.pepk
!android/app/debug.keystore
