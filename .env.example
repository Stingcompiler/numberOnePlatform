# =============================================================================
# .env.example — نموذج متغيرات البيئة
# =============================================================================
# انسخ هذا الملف إلى .env وعيّن القيم الحقيقية.
# ⚠️  لا تُرفع .env على Git أبداً — أضفه إلى .gitignore
# =============================================================================

# ─── Django Core ─────────────────────────────────────────────────────────────
# مفتاح سري عشوائي طويل — يمكن توليده بـ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-change-before-production

# True للتطوير المحلي فقط، False دائماً في الإنتاج
DEBUG=True

# قائمة مفصولة بفواصل — استبدل بالدومين الحقيقي في الإنتاج
# مثال إنتاج: ALLOWED_HOSTS=number-platform-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── قاعدة البيانات ──────────────────────────────────────────────────────────
# الإنتاج (Render يحقن هذا تلقائياً — لا حاجة لتعيينه يدوياً):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# التطوير المحلي — SQLite (الافتراضي إذا لم يُعيَّن DATABASE_URL):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=   ← اتركه فارغاً لـ db.sqlite3 في جذر المشروع

# التطوير المحلي — PostgreSQL يدوي (بديل عن DATABASE_URL):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=number_platform_dev
# DB_USER=postgres
# DB_PASSWORD=your-local-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ─── CORS & CSRF ─────────────────────────────────────────────────────────────
# التطوير المحلي (Vite dev server):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# الإنتاج — غيّر إلى دومين Render الفعلي:
# CORS_ALLOWED_ORIGINS=https://number-platform-api.onrender.com
# CSRF_TRUSTED_ORIGINS=https://number-platform-api.onrender.com

# ─── Cookies ─────────────────────────────────────────────────────────────────
# False للتطوير (HTTP), True للإنتاج (HTTPS)
# ملاحظة: القيمة الافتراضية في settings.py هي not DEBUG
# أي أنها تُعيَّن تلقائياً — لا حاجة لتعيينها يدوياً في الغالب
COOKIE_SECURE=False

# ─── التخزين الدائم لملفات الوسائط (الصور المرفوعة) ──────────────────────────
# في Render (عند استخدام Persistent Disk): MEDIA_ROOT=/var/data/media
# في التطوير المحلي: اتركه فارغاً ليُستخدَم media/ في جذر المشروع تلقائياً
# MEDIA_ROOT=/var/data/media

# ─── إعدادات أمان الإنتاج ────────────────────────────────────────────────────
# False إذا كان Render Load Balancer يتولى HTTPS redirect
# (Render يتولى ذلك تلقائياً — اضبطها False لتجنب redirect loops)
# SECURE_SSL_REDIRECT=False
