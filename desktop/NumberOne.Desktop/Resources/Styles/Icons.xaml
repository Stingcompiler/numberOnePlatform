    <!--
        The design's icon set, ported verbatim.

        Claude Design draws every icon as an inline SVG on a 24x24 viewBox with
        a 1.75 stroke and no fill. MAUI's Path takes the same path mini-language
        in PathGeometry.Figures, so these are the design's own "d" attributes -
        copied, not redrawn. Where an icon was several <path> elements, the
        subpaths are concatenated: a path string may hold as many M-commands as
        it likes.

        Consume through the IconPath style in Theme.xaml, which sets
        Aspect="Uniform" so a 24-unit geometry renders in a 16x16 slot the way
        a viewBox does in the browser.
    -->

    <!-- ── Sidebar navigation ───────────────────────────────────────────── -->
    <PathGeometry x:Key="IconHome"
                  Figures="M3 9.6 12 3l9 6.6V20a1 1 0 0 1-1 1h-5v-6.5H9V21H4a1 1 0 0 1-1-1V9.6Z" />

    <PathGeometry x:Key="IconCourses"
                  Figures="M2 4.5h5.5A3.5 3.5 0 0 1 11 8v12a2.6 2.6 0 0 0-2.6-2.2H2V4.5Z M22 4.5h-5.5A3.5 3.5 0 0 0 13 8v12a2.6 2.6 0 0 1 2.6-2.2H22V4.5Z" />

