<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Named styles over the tokens in Tokens.xaml, so a page says
        Style="{StaticResource BodyLabel}" instead of spelling out an
        AppThemeBinding every time.

        Type ramp is strict - 20 / 15 / 13 / 12 / 11, weights 400 / 500 / 700.
        Nothing above 20px in app UI.
    -->

    <!-- ── Text ─────────────────────────────────────────────────────────── -->

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUiBold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="HeadingLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontHeading}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUiBold}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Running copy. Tajawal once the real faces land; see Tokens.xaml. -->
    <Style x:Key="CopyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontCopy}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <!-- Field label above an input. -->
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource MutedLabel}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        Latin technical values - device ids, machine names, phone numbers,
        timestamps - sit in LTR islands inside the RTL layout, in a monospace
        face. A device id read as RTL is a device id the student cannot dictate.
    -->
    <Style x:Key="MonoLtrLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontLabel}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <!-- ── Surfaces ─────────────────────────────────────────────────────── -->

    <!-- Elevation comes from a 1px border, never a shadow. Shadows are only for
         things that genuinely float: dialogs, popovers, toasts. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="Dialog" TargetType="Border" BasedOn="{StaticResource Panel}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceElevatedLight}, Dark={StaticResource SurfaceElevatedDark}}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Shadow">
            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.12" />
        </Setter>
    </Style>

    <!-- Errors are a bordered tint panel with the message beneath, never a
         filled red block. -->
    <Style x:Key="ErrorPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Administrative blocks use warning, not danger: the account is fine. -->
    <Style x:Key="WarningPanel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarningTintLight}, Dark={StaticResource WarningTintDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="DeviceStrip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource HoverDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ── Controls ─────────────────────────────────────────────────────── -->

    <!--
        Six button treatments, separated by treatment rather than hue, because
        red is both the brand colour and the danger colour. Primary and
        Secondary are filled; Neutral is the default; Ghost is transparent.
        A filled red button exists only inside a confirmation dialog.
    -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryHoverLight}, Dark={StaticResource PrimaryHoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DisabledBgLight}, Dark={StaticResource DisabledBgDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DisabledTextLight}, Dark={StaticResource DisabledTextDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonLarge" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightLarge}" />
    </Style>

    <Style x:Key="NeutralButton" TargetType="Button">
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeight}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource HoverDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="NeutralButtonSmall" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightSmall}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NeutralButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <!-- Login fields are 40px; everywhere else inputs are 32px. -->
    <Style x:Key="LoginEntry" TargetType="Entry">
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightLarge}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <!-- Usernames are Latin; typing them into an RTL field puts the caret
             on the wrong side and reorders what the student sees. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
    </Style>

    <Style x:Key="InputShell" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HeightRequest" Value="{StaticResource ControlHeightLarge}" />
    </Style>

</ResourceDictionary>
