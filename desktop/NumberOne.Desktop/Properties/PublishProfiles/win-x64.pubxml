<?xml version="1.0" encoding="utf-8"?>
<!--
  How this app gets onto a school PC.

  Self-contained on purpose. These are lab and classroom machines that
  nobody administers on our behalf, and asking a school to install a .NET
  runtime before a student can open a lecture is asking for the app not to
  be installed. The whole runtime ships with it: bigger download, no
  prerequisite, no version that can drift underneath us.

  Unpackaged (WindowsPackageType stays None in the project). MSIX would give
  us an update channel, but it needs a signing certificate the school does
  not have yet and it changes where the app is allowed to write - the crash
  log and the token store both assume ordinary user paths today. That is a
  deliberate later step, not a thing to change on the way out of the door.

  ReadyToRun is on. It roughly doubles the on-disk size of the managed
  assemblies and takes a noticeable slice off the cold start, which is the
  moment a student is most likely to think the app has not opened.

  Publish with:
      dotnet publish desktop/NumberOne.Desktop/NumberOne.Desktop.csproj ^
          -f net10.0-windows10.0.19041.0 -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      RuntimeIdentifierOverride, not RuntimeIdentifier.

      This project multi-targets Windows and Mac Catalyst, and a plain
      RuntimeIdentifier is applied to every target framework during restore -
      including the Mac Catalyst one, which runs on Mono. NuGet then goes
      looking for Microsoft.NETCore.App.Runtime.Mono.win-x64, a package that
      cannot exist, and the publish fails before it compiles anything. The
      override sets the identifier for the framework actually being published
      and leaves the other one alone.
    -->
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>

    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Neither is supported for a WinUI app: it loads native components by
         path at runtime, so a single bundled file has nothing to load, and
         the XAML type information is reached by reflection that trimming
         cannot see. Both are set explicitly so nobody has to rediscover it. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
