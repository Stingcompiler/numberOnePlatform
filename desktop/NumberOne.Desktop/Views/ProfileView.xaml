<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:ui="clr-namespace:NumberOne.Desktop.Markup"
             x:Class="NumberOne.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <!--
        حسابي — read-only, in two columns: the record on the leading side, the
        device and the money on the trailing one.

        Two things are deliberately absent and must stay absent.

        There is NO password control. Students never change their own password;
        it is issued and reset by the administration, and the server refuses the
        request outright (IsStudentReadOnly on /auth/change-password/). A field
        here would fail every time it was used.

        There is NO unbind control. Clearing a device binding goes through the
        administration; this screen explains that and shows the identifier so a
        student can quote it accurately over the phone.
    -->

    <ScrollView>
        <Grid Padding="24" ColumnDefinitions="*,*" ColumnSpacing="24"
              RowDefinitions="Auto">

            <!-- ══ البيانات الشخصية ══════════════════════════════════════ -->
            <VerticalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Start">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="البيانات الشخصية"
                           Style="{StaticResource HeadingLabel}" />
                    <BoxView Grid.Column="1" Style="{StaticResource SectionRule}" />
                </Grid>

                <!--
                    A record, not a form.

                    Each value used to sit in a bordered box - the style the top
                    bar's search field uses - with its label above it, and the
                    page read as something to fill in. Nothing on it is
                    editable; there is not an input on the screen.

                    So the boxes are gone and the card carries the edge instead
                    of eight separate ones. Label small and muted, value below
                    it, hairlines between rows: the same shape the الجهاز
                    المرتبط card beside it was already using.

                    نوع النظام is a category rather than something a student
                    typed, so it takes a chip. It used to wear the disabled
                    input fill, which only said anything while everything around
                    it looked editable.
                -->
                <Border Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="اسم الطالب" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding FullName}" Style="{StaticResource CellLabelStrong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="اسم المستخدم" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Username}" Style="{StaticResource CellLabelStrong}"
                                       FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource RowRule}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="رقم الهاتف" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Phone}" Style="{StaticResource CellLabelStrong}"
                                       FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="هاتف ولي الأمر" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding GuardianPhone}" Style="{StaticResource CellLabelStrong}"
                                       FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource RowRule}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="اسم ولي الأمر" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding GuardianName}" Style="{StaticResource CellLabelStrong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="السكن" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Address}" Style="{StaticResource CellLabelStrong}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource RowRule}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="المشرفة" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding SupervisorName}" Style="{StaticResource CellLabelStrong}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="نوع النظام" Style="{StaticResource MutedLabel}" />
                                <Border Style="{StaticResource Chip}" HorizontalOptions="Start">
                                    <Label Text="{Binding SystemTypeDisplay}" Style="{StaticResource ChipLabel}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ══ الجهاز والملف المالي ══════════════════════════════════ -->
            <VerticalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Start">

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="الجهاز المرتبط"
                               Style="{StaticResource HeadingLabel}" />
                        <BoxView Grid.Column="1" Style="{StaticResource SectionRule}" />
                    </Grid>

                    <Border Style="{StaticResource Panel}">
                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="النوع" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding DeviceType}" Style="{StaticResource CellLabelStrong}"
                                           FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="المعرّف" Style="{StaticResource MutedLabel}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <!-- Monospace and LTR. A device id read
                                             right-to-left is one the student
                                             cannot dictate over a phone. -->
                                        <Label Grid.Column="0" Text="{Binding DeviceId}"
                                               Style="{StaticResource MonoLtrLabel}"
                                               FontSize="{StaticResource FontSecondary}"
                                               LineBreakMode="MiddleTruncation" />
                                        <Border Grid.Column="1" WidthRequest="24" HeightRequest="24"
                                                Padding="0" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="Transparent">
                                            <shapes:Path Style="{StaticResource IconPathMuted}"
                                                         WidthRequest="13" HeightRequest="13"
                                                         Data="{ui:Icon Key=IconCopy}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding CopyDeviceIdCommand}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="تاريخ الربط" Style="{StaticResource MutedLabel}" />
                                    <Label Text="{Binding DeviceBoundAt}" Style="{StaticResource CellLabelStrong}"
                                           FlowDirection="LeftToRight" HorizontalTextAlignment="Start" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Style="{StaticResource SectionRule}" />

                            <Label Text="حسابك مرتبط بهذا الجهاز فقط. لاستخدام جهاز آخر يجب مراجعة الإدارة لفك الارتباط."
                                   Style="{StaticResource CopyLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="الملف المالي"
                               Style="{StaticResource HeadingLabel}" />
                        <BoxView Grid.Column="1" Style="{StaticResource SectionRule}" />
                    </Grid>

                    <!--
                        One line, not the design's three.

                        The design shows إجمالي المطلوب and إجمالي المدفوع above
                        المتبقي. Neither is reachable by a student: finance's
                        StudentFinancialFileView is IsAdminOrManager, and the only
                        figure that rides along on /auth/me/ is the balance. The
                        two rows are omitted rather than filled with a guess.
                    -->
                    <Border Style="{StaticResource TableCard}">
                        <Grid HeightRequest="40" Padding="16,0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="المتبقي"
                                   Style="{StaticResource CellLabelStrong}" />
                            <Label Grid.Column="1" Text="{Binding BalanceLabel}"
                                   Style="{StaticResource CellLabelStrong}"
                                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentView>
