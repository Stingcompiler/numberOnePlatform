<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="NumberOne.Desktop.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
             Shell.NavBarIsVisible="False">

    <!--
        No shell on this route. Split layout: the brand panel takes 42% on the
        RIGHT - the leading edge in an RTL layout - and the form sits beside it.
    -->
    <Grid>
        <Grid ColumnDefinitions="42*,58*">

            <!-- ── Brand panel (leading / right) ───────────────────────── -->
            <Grid Grid.Column="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

                <!-- 1px leading border, not a shadow: elevation comes from lines. -->
                <BoxView HorizontalOptions="End" WidthRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <VerticalStackLayout VerticalOptions="Center" Padding="48" Spacing="16">

                    <HorizontalStackLayout Spacing="12">
                        <Border WidthRequest="40" HeightRequest="40" Padding="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                            <Label Text="١" TextColor="#FFFFFF"
                                   FontSize="{StaticResource FontHeading}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static vm:UiText.BrandShortName}"
                               Style="{StaticResource TitleLabel}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{x:Static vm:UiText.BrandName}"
                           Style="{StaticResource HeadingLabel}" />

                    <Label Text="{x:Static vm:UiText.BrandTagline}"
                           Style="{StaticResource CopyLabel}"
                           MaximumWidthRequest="360" />

                    <VerticalStackLayout Spacing="10" Margin="0,12,0,0">
                        <HorizontalStackLayout Spacing="8">
                            <shapes:Path Style="{StaticResource IconPath}" StrokeThickness="2"
                                         WidthRequest="15" HeightRequest="15"
                                         Data="{StaticResource IconCheck}"
                                         Stroke="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                            <Label Text="{x:Static vm:UiText.BrandBulletOne}" Style="{StaticResource SecondaryLabel}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <shapes:Path Style="{StaticResource IconPath}" StrokeThickness="2"
                                         WidthRequest="15" HeightRequest="15"
                                         Data="{StaticResource IconCheck}"
                                         Stroke="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                            <Label Text="{x:Static vm:UiText.BrandBulletTwo}" Style="{StaticResource SecondaryLabel}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <shapes:Path Style="{StaticResource IconPath}" StrokeThickness="2"
                                         WidthRequest="15" HeightRequest="15"
                                         Data="{StaticResource IconCheck}"
                                         Stroke="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                            <Label Text="{x:Static vm:UiText.BrandBulletThree}" Style="{StaticResource SecondaryLabel}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <!-- ── Form ────────────────────────────────────────────────── -->
            <ScrollView Grid.Column="1">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Padding="24,48" Spacing="12">

                    <!-- The school's own mark, above the card. -->
                    <Border WidthRequest="96" HeightRequest="96" Padding="0"
                            StrokeThickness="0" StrokeShape="RoundRectangle 48"
                            HorizontalOptions="Center">
                        <Image Source="number_one_logo.jpg" Aspect="AspectFill"
                               WidthRequest="96" HeightRequest="96" />
                    </Border>

                    <Border Style="{StaticResource Panel}" Padding="24" WidthRequest="420">
                        <VerticalStackLayout Spacing="16">

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{x:Static vm:UiText.LoginTitle}" Style="{StaticResource TitleLabel}" />
                                <Label Text="{x:Static vm:UiText.LoginSubtitle}" Style="{StaticResource MutedLabel}"
                                       FontSize="{StaticResource FontSecondary}" />
                            </VerticalStackLayout>

                            <!-- Username -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{x:Static vm:UiText.UsernameLabel}" Style="{StaticResource MutedLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <shapes:Path Grid.Column="0" Style="{StaticResource IconPathMuted}"
                                                     WidthRequest="15" HeightRequest="15"
                                                     Data="{StaticResource IconUser}" />
                                        <Entry Grid.Column="1" Text="{Binding Username}"
                                               Style="{StaticResource LoginEntry}"
                                               ReturnType="Next"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password, with the eye toggle -->
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{x:Static vm:UiText.PasswordLabel}" Style="{StaticResource MutedLabel}" />
                                <Border Style="{StaticResource InputShell}">
                                    <Grid ColumnDefinitions="Auto,*,24" ColumnSpacing="8">
                                        <shapes:Path Grid.Column="0" Style="{StaticResource IconPathMuted}"
                                                     WidthRequest="15" HeightRequest="15"
                                                     Data="{StaticResource IconLock}" />
                                        <Entry Grid.Column="1"
                                               Text="{Binding Password}"
                                               IsPassword="{Binding PasswordVisible, Converter={StaticResource Invert}}"
                                               Style="{StaticResource LoginEntry}"
                                               ReturnType="Go"
                                               ReturnCommand="{Binding SignInCommand}"
                                               VerticalOptions="Center" />
                                        <shapes:Path Grid.Column="2" Style="{StaticResource IconPathMuted}"
                                                     WidthRequest="15" HeightRequest="15"
                                                     Data="{StaticResource IconEye}"
                                                     ToolTipProperties.Text="{x:Static vm:UiText.ShowPassword}">
                                            <shapes:Path.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                            </shapes:Path.GestureRecognizers>
                                        </shapes:Path>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!--
                                Error panel: tint fill with a 1px danger border
                                and the message inside. Never a filled red block.
                            -->
                            <Border Style="{StaticResource ErrorPanel}" IsVisible="{Binding HasError}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <shapes:Path Grid.Column="0" Style="{StaticResource IconPath}"
                                                 WidthRequest="14" HeightRequest="14"
                                                 Data="{StaticResource IconAlertCircle}"
                                                 Stroke="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                                    <Label Grid.Column="1" Text="{Binding ErrorMessage}"
                                           Style="{StaticResource CopyLabel}"
                                           TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                                </Grid>
                            </Border>

                            <Button Text="{Binding SubmitLabel}"
                                    Command="{Binding SignInCommand}"
                                    Style="{StaticResource PrimaryButtonLarge}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Which machine this is, and what signing in here will
                         bind. Said before the binding, not after it. -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"
                          HorizontalOptions="Center" WidthRequest="420">
                        <shapes:Path Grid.Column="0" Style="{StaticResource IconPathMuted}"
                                     WidthRequest="13" HeightRequest="13"
                                     Data="{StaticResource IconMonitor}" />
                        <Label Grid.Column="1" Text="{Binding DeviceFootnote}"
                               Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ── Binding confirmation ────────────────────────────────────────
             A 520px dialog over the dimmed login. Drawn as an overlay in this
             page rather than a platform popup: the design specifies exactly
             this, and it keeps the flow in one view model.
        -->
        <Grid IsVisible="{Binding IsBindConfirmationVisible}"
              BackgroundColor="{StaticResource Scrim}">

            <Border Style="{StaticResource Dialog}"
                    WidthRequest="520"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">

                    <HorizontalStackLayout Spacing="12">
                        <Border WidthRequest="40" HeightRequest="40" Padding="0"
                                StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningTintLight}, Dark={StaticResource WarningTintDark}}">
                            <Label Text="!" FontAttributes="Bold"
                                   FontSize="{StaticResource FontHeading}"
                                   TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static vm:UiText.BindTitle}"
                               Style="{StaticResource HeadingLabel}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{x:Static vm:UiText.BindBody}" Style="{StaticResource CopyLabel}" />

                    <!-- Device strip: what exactly is about to be bound. -->
                    <Border Style="{StaticResource DeviceStrip}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{x:Static vm:UiText.BindCurrentDevice}"
                                   Style="{StaticResource SecondaryLabel}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DeviceDescription}"
                                   Style="{StaticResource MonoLtrLabel}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Primary is visibly wider: confirming is the main action,
                         and it is the irreversible one. -->
                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                        <Button Text="{x:Static vm:UiText.BindConfirm}"
                                Command="{Binding ConfirmBindCommand}"
                                Style="{StaticResource PrimaryButton}"
                                WidthRequest="200" />
                        <Button Text="{x:Static vm:UiText.BindCancel}"
                                Command="{Binding CancelBindCommand}"
                                Style="{StaticResource NeutralButton}"
                                WidthRequest="96" />
                    </HorizontalStackLayout>

                    <Label Text="{x:Static vm:UiText.BindFootnote}" Style="{StaticResource MutedLabel}" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
