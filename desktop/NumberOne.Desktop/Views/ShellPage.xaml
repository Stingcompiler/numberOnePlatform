<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.ShellPage"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

    <!--
        The app chrome: a 240px sidebar and the content area beside it.

        The sidebar is column 0, which in this RTL layout puts it on the RIGHT —
        the mobile app's six bottom tabs become this rail. Desktop is not a
        scaled-up phone: 36px nav rows, 13px labels, no bottom bar.
    -->
    <Grid>
      <Grid RowDefinitions="Auto,*">

        <!--
            Offline bar. Persists across routes, which is why it lives here
            rather than on a screen. Warning-tinted with a danger bottom rule:
            the session is fine, the network is not.
        -->
        <Border Grid.Row="0" x:Name="OfflineBar" IsVisible="False"
                HeightRequest="32" Padding="16,0" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" x:Name="OfflineLabel"
                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="إعادة الاتصال"
                        Style="{StaticResource GhostButton}"
                        HeightRequest="24" VerticalOptions="Center"
                        Clicked="OnReconnectClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="240,*">

        <!-- ── Sidebar ─────────────────────────────────────────────────── -->
        <Grid Grid.Column="0"
              BackgroundColor="{AppThemeBinding Light={StaticResource SidebarLight}, Dark={StaticResource SidebarDark}}">

            <!-- Trailing 1px rule. Elevation is a line, never a shadow. -->
            <BoxView HorizontalOptions="Start" WidthRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <Grid RowDefinitions="Auto,*,Auto" Padding="12,16">

                <!-- Brand block -->
                <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="4,0,4,20">
                    <Border WidthRequest="28" HeightRequest="28" Padding="0"
                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                        <Label Text="١" TextColor="#FFFFFF" FontAttributes="Bold"
                               FontSize="{StaticResource FontBody}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{x:Static vm:UiText.BrandShortName}"
                           Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Primary nav -->
                <VerticalStackLayout Grid.Row="1" Spacing="2">
                    <Label Text="التعلّم" Style="{StaticResource MutedLabel}" Margin="8,0,8,6" />

                    <Button x:Name="NavHome" Text="لوحة التحكم"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="36" HorizontalOptions="Fill"
                            Clicked="OnHomeClicked" />
                    <Button x:Name="NavCourses" Text="الكورسات"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="36" HorizontalOptions="Fill"
                            Clicked="OnCoursesClicked" />
                    <Button x:Name="NavLive" Text="البث المباشر"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="36" HorizontalOptions="Fill"
                            Clicked="OnLiveClicked" />
                    <Button x:Name="NavExams" Text="الاختبارات"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="36" HorizontalOptions="Fill"
                            Clicked="OnExamsClicked" />
                    <Button x:Name="NavResults" Text="النتائج"
                            Style="{StaticResource GhostButton}"
                            HeightRequest="36" HorizontalOptions="Fill"
                            Clicked="OnResultsClicked" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" x:Name="NavNotifications" Text="الإشعارات"
                                Style="{StaticResource GhostButton}"
                                HeightRequest="36" HorizontalOptions="Fill"
                                Clicked="OnNotificationsClicked" />
                        <!-- Zero hides it; over 99 renders "٩٩+". -->
                        <Label Grid.Column="1" x:Name="NotificationBadge" IsVisible="False"
                               VerticalOptions="Center" Margin="0,0,8,0"
                               FontSize="{StaticResource FontLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- User block -->
                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label x:Name="SidebarStudentName" Style="{StaticResource BodyLabel}" Margin="8,4,8,0" />

                    <Button x:Name="NavProfile" Text="حسابي"
                            Style="{StaticResource GhostButton}"
                            HorizontalOptions="Fill"
                            Clicked="OnProfileClicked" />

                    <Button x:Name="SignOutButton"
                            Text="تسجيل الخروج"
                            Style="{StaticResource GhostButton}"
                            HorizontalOptions="Fill"
                            Clicked="OnSignOutClicked" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ── Content ─────────────────────────────────────────────────── -->
        <ContentView Grid.Column="1" x:Name="ContentHost" />
        </Grid>
      </Grid>

      <!--
          Session expired. A dropped connection is NOT this: the handler only
          raises it when the refresh token was actually rejected, so an offline
          student keeps their session and sees the bar instead.
      -->
      <Grid x:Name="SessionExpiredScrim" IsVisible="False"
            BackgroundColor="{StaticResource Scrim}">
          <Border Style="{StaticResource Dialog}" WidthRequest="480"
                  HorizontalOptions="Center" VerticalOptions="Center">
              <VerticalStackLayout Spacing="12">
                  <Label Text="{x:Static vm:UiText.SessionExpiredTitle}" Style="{StaticResource HeadingLabel}" />
                  <Label Text="{x:Static vm:UiText.SessionExpiredBody}" Style="{StaticResource CopyLabel}" />
                  <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                      <Button Text="{x:Static vm:UiText.SessionExpiredContinue}"
                              Style="{StaticResource PrimaryButton}"
                              Clicked="OnSessionExpiredContinue" />
                      <Button Text="{x:Static vm:UiText.SessionExpiredBackToLogin}"
                              Style="{StaticResource NeutralButton}"
                              Clicked="OnSessionExpiredContinue" />
                  </HorizontalStackLayout>
              </VerticalStackLayout>
          </Border>
      </Grid>
    </Grid>
</ContentPage>
