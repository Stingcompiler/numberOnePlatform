<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- ── Header ──────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding StudentName}" Style="{StaticResource TitleLabel}" />
                    <Label Text="{Binding SystemTypeDisplay}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <!-- Remaining balance, in warning. The only part of the
                         financial file a student can read. -->
                    <VerticalStackLayout IsVisible="{Binding HasBalance}" Spacing="2">
                        <Label Text="المتبقي" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
                        <Label Text="{Binding RemainingBalance}"
                               FontSize="{StaticResource FontHeading}" FontAttributes="Bold"
                               HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}" />
                    </VerticalStackLayout>

                    <Button Text="تحديث" Command="{Binding ReloadCommand}"
                            Style="{StaticResource NeutralButtonSmall}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- ── Stat row ────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="الكورسات" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding CourseCount}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="المحاضرات" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding LessonCount}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="التقدّم" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding ProgressPercent, StringFormat='{0}٪'}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="اختبارات قادمة" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding PendingExamCount}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ── Live banner ─────────────────────────────────────────── -->
            <Border Style="{StaticResource WarningPanel}" IsVisible="{Binding HasLiveBanner}">
                <Grid ColumnDefinitions="*,Auto" BindingContext="{Binding BannerSession}" x:DataType="models:LiveSession">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding SessionName}" Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding StatusDisplay}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="يُفتح في المتصفح"
                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- ── Upcoming exams ──────────────────────────────────────── -->
            <VerticalStackLayout Spacing="8">
                <Label Text="اختبارات قادمة" Style="{StaticResource HeadingLabel}" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <!-- Every region carries all four states. -->
                <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                       IsVisible="{Binding Exams.IsLoading}" />
                <Label Text="لا توجد اختبارات قادمة." Style="{StaticResource SecondaryLabel}"
                       IsVisible="{Binding Exams.IsEmpty}" />

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Exams.HasError}">
                    <Label Text="{Binding Exams.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                           VerticalOptions="Center" />
                    <Button Text="إعادة المحاولة" Command="{Binding Exams.LoadCommand}"
                            Style="{StaticResource NeutralButtonSmall}" />
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exams.Value}"
                                     IsVisible="{Binding Exams.HasData}" Spacing="1">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ExamSummary">
                            <Grid ColumnDefinitions="*,Auto,Auto" HeightRequest="48" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding CourseName}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" VerticalOptions="Center"
                                       Text="{Binding QuestionCount, StringFormat='{0} سؤال'}"
                                       Style="{StaticResource MutedLabel}" />
                                <Label Grid.Column="2" VerticalOptions="Center"
                                       Text="{Binding DurationMinutes, StringFormat='{0} دقيقة'}"
                                       Style="{StaticResource MutedLabel}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Continue where you left off ─────────────────────────── -->
            <VerticalStackLayout Spacing="8">
                <Label Text="تابع من حيث توقفت" Style="{StaticResource HeadingLabel}" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                       IsVisible="{Binding Courses.IsLoading}" />
                <Label Text="لم تُفتح لك كورسات بعد." Style="{StaticResource SecondaryLabel}"
                       IsVisible="{Binding Courses.IsEmpty}" />

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Courses.HasError}">
                    <Label Text="{Binding Courses.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                           VerticalOptions="Center" />
                    <Button Text="إعادة المحاولة" Command="{Binding Courses.LoadCommand}"
                            Style="{StaticResource NeutralButtonSmall}" />
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ContinueLearning}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CourseProgress">
                            <Border Style="{StaticResource Panel}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Course.Name}"
                                           Style="{StaticResource BodyLabel}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding ProgressLabel}"
                                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding Percent, Converter={StaticResource PercentToFraction}}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Recent notifications ────────────────────────────────── -->
            <VerticalStackLayout Spacing="8">
                <Label Text="آخر الإشعارات" Style="{StaticResource HeadingLabel}" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                       IsVisible="{Binding Notifications.IsLoading}" />
                <Label Text="لا توجد إشعارات." Style="{StaticResource SecondaryLabel}"
                       IsVisible="{Binding Notifications.IsEmpty}" />

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Notifications.HasError}">
                    <Label Text="{Binding Notifications.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                           VerticalOptions="Center" />
                    <Button Text="إعادة المحاولة" Command="{Binding Notifications.LoadCommand}"
                            Style="{StaticResource NeutralButtonSmall}" />
                </HorizontalStackLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notifications.Value}"
                                     IsVisible="{Binding Notifications.HasData}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Notification">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,6">
                                <!-- Unread dot in primary; hidden once read. -->
                                <Ellipse Grid.Column="0" WidthRequest="6" HeightRequest="6"
                                         VerticalOptions="Start" Margin="0,6,0,0"
                                         IsVisible="{Binding IsRead, Converter={StaticResource Invert}}"
                                         Fill="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding Message}" Style="{StaticResource CopyLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
