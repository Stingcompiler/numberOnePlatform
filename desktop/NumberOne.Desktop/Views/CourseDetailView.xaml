<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.CourseDetailView"
             x:DataType="vm:CourseDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Button x:Name="BackButton" Text="← الكورسات"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start" Clicked="OnBackClicked" />

            <!-- Header is a plain region, not a card: nested cards are forbidden. -->
            <VerticalStackLayout Spacing="12" BindingContext="{Binding Course.Value}" x:DataType="vm:CourseDetail"
                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:CourseDetailViewModel}}, Path=Course.HasData}">

                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding Name}" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                    <Border VerticalOptions="Center" Padding="8,2"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9999"
                            BackgroundColor="{Binding IsOnline, Converter={StaticResource SystemTypeTint}}">
                        <Label Text="{Binding SystemTypeDisplay}"
                               FontSize="{StaticResource FontLabel}"
                               TextColor="{Binding IsOnline, Converter={StaticResource SystemTypeInk}}" />
                    </Border>
                </HorizontalStackLayout>

                <Label Text="{Binding Description}" Style="{StaticResource CopyLabel}" />

                <!-- Three stat columns: وحدات / محاضرات / تقدّم -->
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="32">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="وحدات" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding UnitCountLabel}" Style="{StaticResource HeadingLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="محاضرات" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding LessonCountLabel}" Style="{StaticResource HeadingLabel}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="تقدّم" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding PercentLabel}" Style="{StaticResource HeadingLabel}" />
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{Binding TeacherName}"
                           Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                    <ProgressBar Grid.Column="1" VerticalOptions="Center"
                                 Progress="{Binding Percent, Converter={StaticResource PercentToFraction}}"
                                 ProgressColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
                </Grid>
            </VerticalStackLayout>

            <!-- States -->
            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Course.IsLoading}" />
            <Label Text="لم تُضف محاضرات إلى هذا الكورس بعد." Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Course.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Course.HasError}">
                <Label Text="{Binding Course.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                       VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding Course.LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <!-- Units accordion. Expanded by default; a unit is a heading with
                 its lesson rows beneath, not a nested card. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Course.Value.Units}"
                                 IsVisible="{Binding Course.HasData}" Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnitRow">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="40">
                                <Label Grid.Column="0" Text="{Binding Name}"
                                       Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ProgressLabel}"
                                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LessonRow">
                                        <Grid ColumnDefinitions="28,*,Auto,Auto,Auto" HeightRequest="40" ColumnSpacing="8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CourseDetailViewModel}}, Path=OpenLessonCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <Label Grid.Column="0" Text="{Binding IndexLabel}"
                                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Title}"
                                                   Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding DurationLabel}"
                                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="الملف المرفق"
                                                   IsVisible="{Binding HasAttachment}"
                                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding StatusLabel}"
                                                   VerticalOptions="Center"
                                                   FontSize="{StaticResource FontLabel}"
                                                   TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
