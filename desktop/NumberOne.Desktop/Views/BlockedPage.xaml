<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.BlockedPage"
             x:DataType="vm:BlockedPageViewModel"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
             Shell.NavBarIsVisible="False">

    <!--
        No shell. One page serves both blocked states - they differ in title,
        body and what the detail card can show, not in structure.
    -->
    <ScrollView>
        <VerticalStackLayout WidthRequest="520"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Padding="24,48" Spacing="16">

            <Border WidthRequest="64" HeightRequest="64" Padding="0"
                    HorizontalOptions="Center"
                    StrokeThickness="0" StrokeShape="RoundRectangle 32"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTintLight}, Dark={StaticResource PrimaryTintDark}}">
                <Label Text="{Binding Glyph}"
                       FontSize="30"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding Title}"
                   Style="{StaticResource TitleLabel}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding Body}"
                   Style="{StaticResource CopyLabel}"
                   MaximumWidthRequest="480"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Detail card -->
            <Border Style="{StaticResource Panel}" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="12">

                    <!-- Only present when the probe revealed the other device. -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBoundDevice}">
                        <Label Grid.Column="0" Text="{x:Static vm:UiText.BoundDeviceLabel}"
                               Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BoundDeviceDescription}"
                               Style="{StaticResource MonoLtrLabel}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasBoundAt}">
                        <Label Grid.Column="0" Text="{x:Static vm:UiText.BoundAtLabel}"
                               Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BoundAtDisplay}"
                               Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1" IsVisible="{Binding HasBoundDevice}"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <!--
                        The identifier, always shown and always copyable. This is
                        the screen where the student needs it and cannot reach
                        the rest of the app; nobody dictates a 16-character hex
                        string accurately over a phone.
                    -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{x:Static vm:UiText.ThisMachineIdLabel}"
                               Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding DeviceId}"
                               Style="{StaticResource MonoLtrLabel}" VerticalOptions="Center" />
                        <Button Grid.Row="1" Grid.ColumnSpan="2"
                                Text="{x:Static vm:UiText.CopyDeviceId}"
                                Command="{Binding CopyDeviceIdCommand}"
                                Style="{StaticResource NeutralButtonSmall}"
                                HorizontalOptions="Start" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                <Button Text="{Binding ContactLabel}"
                        Command="{Binding ContactAdministrationCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Text="{x:Static vm:UiText.SignInWithAnotherAccount}"
                        Command="{Binding BackToLoginCommand}"
                        Style="{StaticResource NeutralButton}" />
            </HorizontalStackLayout>

            <Label Text="{Binding ToastMessage}"
                   IsVisible="{Binding HasToast}"
                   Style="{StaticResource MutedLabel}"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
