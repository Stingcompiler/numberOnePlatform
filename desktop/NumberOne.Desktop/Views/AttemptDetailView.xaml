<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.AttemptDetailView"
             x:DataType="vm:AttemptDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Back lives in the top bar, not here. -->

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Attempt.IsLoading}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="400" />
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="340" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Attempt.HasError}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="{Binding Attempt.ErrorMessage}"
                           Style="{StaticResource CellLabelSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="إعادة المحاولة" Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Center" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding Attempt.HasData}" Spacing="16">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding Attempt.Value.ExamTitle}" Style="{StaticResource TitleLabel}" />
                        <Label Text="{Binding DateLabel}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="الدرجة" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
                        <Label Text="{Binding ScoreLabel}" Style="{StaticResource HeadingLabel}"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" VerticalOptions="Center" Padding="10,4"
                            StrokeThickness="0" StrokeShape="RoundRectangle 9999"
                            BackgroundColor="{Binding IsPassed, Converter={StaticResource VerdictTint}}">
                        <Label Text="{Binding VerdictLabel}"
                               FontSize="{StaticResource FontSecondary}"
                               TextColor="{Binding IsPassed, Converter={StaticResource VerdictInk}}" />
                    </Border>
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <!--
                    The answer sheet. Correct answers appear here and nowhere
                    earlier: the exam endpoint omits them while the exam can
                    still be sat.
                -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Answers}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnswerRow">
                            <Border Style="{StaticResource Panel}">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding IndexLabel}"
                                               Style="{StaticResource MutedLabel}" VerticalOptions="Start" />
                                        <Label Grid.Column="1" Text="{Binding QuestionText}"
                                               Style="{StaticResource CopyLabel}" />
                                        <Label Grid.Column="2" Text="{Binding MarksLabel}"
                                               Style="{StaticResource MutedLabel}" VerticalOptions="Start" />
                                        <Label Grid.Column="3"
                                               Text="{Binding IsCorrect, Converter={StaticResource CorrectWord}}"
                                               FontSize="{StaticResource FontLabel}" VerticalOptions="Start"
                                               TextColor="{Binding IsCorrect, Converter={StaticResource VerdictInk}}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0" Text="إجابتك"
                                               Style="{StaticResource MutedLabel}" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding StudentAnswerLabel}"
                                               Style="{StaticResource BodyLabel}" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="الصحيحة"
                                               Style="{StaticResource MutedLabel}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CorrectAnswerLabel}"
                                               Style="{StaticResource BodyLabel}"
                                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
