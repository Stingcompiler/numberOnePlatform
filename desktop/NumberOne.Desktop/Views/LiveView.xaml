<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.LiveView"
             x:DataType="vm:LiveViewModel">

    <!--
        Rooms hold links that open OUTSIDE the app. No player, no embedded
        content, and the action looks like the external hand-off it is.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="البث المباشر" Style="{StaticResource TitleLabel}" />
            <Label Text="{x:Static vm:LiveViewModel.HeaderNote}" Style="{StaticResource MutedLabel}" />

            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Rooms.IsLoading}" />
            <Label Text="لا توجد جلسات بث متاحة" Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Rooms.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Rooms.HasError}">
                <Label Text="تعذّر تحميل البث المباشر. يرجى التحقق من اتصالك."
                       Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rooms.Value}" Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:LiveRoom">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="40">
                                <Label Grid.Column="0" Text="{Binding RoomName}"
                                       Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                                <!-- Meta follows Arabic number agreement, not one plural template. -->
                                <Label Grid.Column="1" Text="{Binding SessionCountLabel}"
                                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:LiveSession">
                                        <Grid ColumnDefinitions="2.6*,1.4*,96,76" HeightRequest="44" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding SessionName}" Style="{StaticResource BodyLabel}" />
                                                <Label Text="{Binding Description}" Style="{StaticResource CopyLabel}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding ProviderDisplay}"
                                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding StatusDisplay}"
                                                   Style="{StaticResource MutedLabel}" VerticalOptions="Center" />

                                            <!-- Ended and archived sessions render this disabled. -->
                                            <Button Grid.Column="3" Text="دخول"
                                                    VerticalOptions="Center"
                                                    ToolTipProperties.Text="يُفتح في المتصفح"
                                                    IsEnabled="{Binding CanJoin}"
                                                    Style="{StaticResource NeutralButtonSmall}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LiveViewModel}}, Path=JoinCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
