<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:ui="clr-namespace:NumberOne.Desktop.Markup"
             x:Class="NumberOne.Desktop.Views.LiveView"
             x:Name="Root"
             x:DataType="vm:LiveViewModel">

    <!--
        البث المباشر — rooms holding links that open OUTSIDE the app.

        Deliberately no player and no embed. Every session is a Zoom / Meet /
        Teams / YouTube link, and the header says so up front so a student is
        never surprised by a browser window.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="غرف البث" Style="{StaticResource HeadingLabel}" />
                <BoxView Grid.Column="1" Style="{StaticResource SectionRule}" />
                <shapes:Path Grid.Column="2" Style="{StaticResource IconPathMuted}"
                             WidthRequest="13" HeightRequest="13"
                             Data="{ui:Icon Key=IconLink}" />
                <Label Grid.Column="3" Text="{x:Static vm:LiveViewModel.HeaderNote}"
                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rooms.Value}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:LiveRoom">
                        <Border Style="{StaticResource TableCard}">
                            <VerticalStackLayout>

                                <!-- Room head. -->
                                <Grid Style="{StaticResource TableRow}" HeightRequest="40"
                                      ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                    <shapes:Path Grid.Column="0" Style="{StaticResource IconPath}"
                                                 WidthRequest="14" HeightRequest="14"
                                                 Data="{ui:Icon Key=IconChevronDown}"
                                                 StrokeThickness="1.75" />
                                    <Label Grid.Column="1" Text="{Binding RoomName}"
                                           Style="{StaticResource HeadingLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding SessionCountLabel}"
                                           Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                </Grid>

                                <!-- A room with no sessions says so rather than
                                     collapsing to a bare heading. -->
                                <VerticalStackLayout Padding="16,24" HorizontalOptions="Center"
                                                     IsVisible="{Binding Sessions.Count, Converter={StaticResource ZeroToTrue}}">
                                    <BoxView Style="{StaticResource SectionRule}" Margin="-16,-24,-16,24" />
                                    <Label Text="لا توجد جلسات في هذه الغرفة بعد"
                                           Style="{StaticResource CellLabelSecondary}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:LiveSession">
                                            <Grid Style="{StaticResource TableRow}"
                                                  ColumnDefinitions="28,2.6*,1.4*,96,76"
                                                  ColumnSpacing="12" Padding="16,8"
                                                  MinimumHeightRequest="44">

                                                <BoxView Grid.ColumnSpan="5" Style="{StaticResource SectionRule}"
                                                         VerticalOptions="Start" Margin="-16,0" />

                                                <!-- The provider's own glyph, in a
                                                     bordered tile: which product
                                                     opens matters before the click. -->
                                                <Border Grid.Column="0" WidthRequest="24" HeightRequest="24"
                                                        Padding="0" StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 6"
                                                        VerticalOptions="Center"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource HoverLight}, Dark={StaticResource HoverDark}}"
                                                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                                                    <shapes:Path Style="{StaticResource IconPathSmall}"
                                                                 Data="{Binding Provider, Converter={StaticResource ProviderIcon}}" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding SessionName}"
                                                           Style="{StaticResource CellLabelStrong}" />
                                                    <Label Text="{Binding Description}"
                                                           Style="{StaticResource MutedLabel}" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding ProviderLabel}"
                                                           Style="{StaticResource MutedLabel}"
                                                           FlowDirection="LeftToRight"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                                    <Label Text="{Binding TimeLabel}"
                                                           Style="{StaticResource MutedLabel}"
                                                           FlowDirection="LeftToRight" />
                                                </VerticalStackLayout>

                                                <!-- live → danger, قادمة → warning,
                                                     ended and archived → grey. A
                                                     finished session is not a failure
                                                     and must not read as one. -->
                                                <Border Grid.Column="3" Style="{StaticResource Pill}"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource LiveStatusTint}}">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Ellipse WidthRequest="5" HeightRequest="5"
                                                                 VerticalOptions="Center"
                                                                 IsVisible="{Binding IsLiveNow}"
                                                                 Fill="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                                                        <Label Text="{Binding StatusLabel}"
                                                               Style="{StaticResource PillLabel}"
                                                               TextColor="{Binding Status, Converter={StaticResource LiveStatusInk}}" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <!-- Kept even when it cannot be
                                                     joined: it states the state
                                                     rather than vanishing, and drops
                                                     to muted so it does not invite a
                                                     click that leads nowhere. -->
                                                <Border Grid.Column="4" HeightRequest="28" Padding="10,0"
                                                        StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                                        HorizontalOptions="End" VerticalOptions="Center"
                                                        BackgroundColor="Transparent"
                                                        Stroke="{Binding CanJoin, Converter={StaticResource JoinableBorder}}">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding ActionLabel}"
                                                               Style="{StaticResource PillLabel}"
                                                               FontSize="{StaticResource FontSecondary}"
                                                               TextColor="{Binding CanJoin, Converter={StaticResource JoinableInk}}" />
                                                        <shapes:Path Style="{StaticResource IconPathSmall}"
                                                                     WidthRequest="12" HeightRequest="12"
                                                                     IsVisible="{Binding CanJoin}"
                                                                     Data="{ui:Icon Key=IconExternal}"
                                                                     Stroke="{Binding CanJoin, Converter={StaticResource JoinableInk}}" />
                                                    </HorizontalStackLayout>

                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.JoinCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ══ States ════════════════════════════════════════════════ -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Rooms.IsLoading}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="300" />
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="240" />
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="270" />
                </VerticalStackLayout>
            </Border>

            <!--
                Empty here usually means the server filtered every room out by
                system_type, not that the school scheduled nothing — so the
                message points at the enrolment rather than the calendar.
            -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Rooms.IsEmpty}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="لا توجد جلسات بث متاحة"
                           Style="{StaticResource CellLabelSecondary}" />
                    <Label Text="تُعرض الغرف المطابقة لنظام دراستك فقط."
                           Style="{StaticResource CopyLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Rooms.HasError}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="{Binding Rooms.ErrorMessage}"
                           Style="{StaticResource CellLabelSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="إعادة المحاولة" Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Center" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
