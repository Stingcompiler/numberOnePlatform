<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.ExamsView"
             x:DataType="vm:ExamsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="الاختبارات" Style="{StaticResource TitleLabel}" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="المتاحة" Command="{Binding ShowAvailableCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
                <Button Text="المكتملة" Command="{Binding ShowCompletedCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Exams.IsLoading}" />
            <Label Text="لا توجد اختبارات." Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Exams.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Exams.HasError}">
                <Label Text="{Binding Exams.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                       VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <!-- Available -->
            <VerticalStackLayout IsVisible="{Binding ShowingAvailable}"
                                 BindableLayout.ItemsSource="{Binding Available}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ExamSummary">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" HeightRequest="48" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding CourseName}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" VerticalOptions="Center"
                                       Text="{Binding DurationMinutes, StringFormat='{0} دقيقة'}"
                                       Style="{StaticResource MutedLabel}" />
                                <Label Grid.Column="2" VerticalOptions="Center"
                                       Text="{Binding QuestionCount, StringFormat='{0} سؤال'}"
                                       Style="{StaticResource MutedLabel}" />
                                <Button Grid.Column="3" Text="ابدأ" VerticalOptions="Center"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExamsViewModel}}, Path=StartExamCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Completed -->
            <VerticalStackLayout IsVisible="{Binding ShowingAvailable, Converter={StaticResource Invert}}"
                                 BindableLayout.ItemsSource="{Binding Completed}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ExamSummary">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto,Auto" HeightRequest="48" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding CourseName}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" VerticalOptions="Center"
                                       Text="{Binding BestAttempt.Score}"
                                       Style="{StaticResource BodyLabel}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="2" VerticalOptions="Center"
                                       Text="{Binding BestAttempt.IsPassed, Converter={StaticResource VerdictWord}}"
                                       FontSize="{StaticResource FontSecondary}"
                                       TextColor="{Binding BestAttempt.IsPassed, Converter={StaticResource VerdictInk}}" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
