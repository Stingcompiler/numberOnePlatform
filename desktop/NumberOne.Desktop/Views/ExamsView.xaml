<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.ExamsView"
             x:Name="Root"
             x:DataType="vm:ExamsViewModel">

    <!--
        الإختبارات والإمتحانات — two tabs over one payload.

        /exams/student/list/ returns every active exam with the student's own
        attempts nested, so "المتاحة" and "المكتملة" are two views of the same
        list rather than two fetches.

        The design's الإغلاق column is absent, and cannot be added: exams.Exam
        carries a duration and nothing else — no opening date, no closing date.
        An exam is active or it is not. The column would have to be invented.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <!-- ══ Tabs ══════════════════════════════════════════════════ -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="المتاحة" Style="{StaticResource TabButton}"
                        Command="{Binding ShowAvailableCommand}"
                        BackgroundColor="{Binding ShowingAvailable, Converter={StaticResource SelectedTabTint}}"
                        BorderColor="{Binding ShowingAvailable, Converter={StaticResource SelectedTabBorder}}"
                        TextColor="{Binding ShowingAvailable, Converter={StaticResource SelectedTabInk}}" />
                <Button Text="المكتملة" Style="{StaticResource TabButton}"
                        Command="{Binding ShowCompletedCommand}"
                        BackgroundColor="{Binding ShowingCompleted, Converter={StaticResource SelectedTabTint}}"
                        BorderColor="{Binding ShowingCompleted, Converter={StaticResource SelectedTabBorder}}"
                        TextColor="{Binding ShowingCompleted, Converter={StaticResource SelectedTabInk}}" />
            </HorizontalStackLayout>

            <!-- ══ المتاحة ═══════════════════════════════════════════════ -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding ShowingAvailable}">
                <VerticalStackLayout>

                    <Grid Style="{StaticResource TableHeaderRow}"
                          ColumnDefinitions="2.6*,1.2*,*,*,88">
                        <Label Grid.Column="0" Text="الاختبار" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="1" Text="الكورس" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="2" Text="المدة" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="3" Text="الأسئلة" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="4" Text="إجراء" Style="{StaticResource TableHeaderLabel}"
                               HorizontalTextAlignment="Center" />
                        <BoxView Grid.ColumnSpan="5" Style="{StaticResource RowRule}" Margin="-16,0" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Available}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ExamSummary">
                                <Grid Style="{StaticResource TableRow}"
                                      ColumnDefinitions="2.6*,1.2*,*,*,88" HeightRequest="44">

                                    <Label Grid.Column="0" Text="{Binding Title}"
                                           Style="{StaticResource CellLabel}" />
                                    <Label Grid.Column="1" Text="{Binding CourseName}"
                                           Style="{StaticResource CellLabelSecondary}" />
                                    <Label Grid.Column="2" Text="{Binding DurationLabel}"
                                           Style="{StaticResource CellLabelNumeric}" />
                                    <Label Grid.Column="3" Text="{Binding QuestionCountLabel}"
                                           Style="{StaticResource CellLabelNumeric}" />

                                    <Button Grid.Column="4" Text="{Binding StartLabel}"
                                            Style="{StaticResource PrimaryButtonSmall}"
                                            HorizontalOptions="Center"
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.StartExamCommand}"
                                            CommandParameter="{Binding .}" />

                                    <BoxView Grid.ColumnSpan="5" Style="{StaticResource RowRule}" Margin="-16,0" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══ المكتملة ══════════════════════════════════════════════ -->
            <!--
                The best attempt, not the last: there is no server-side attempt
                limit, so a student may have several, and the record that counts
                is the strongest one.
            -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding ShowingCompleted}">
                <VerticalStackLayout>

                    <Grid Style="{StaticResource TableHeaderRow}"
                          ColumnDefinitions="2.6*,1.2*,*,*,*">
                        <Label Grid.Column="0" Text="الاختبار" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="1" Text="الكورس" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="2" Text="التاريخ" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="3" Text="الدرجة" Style="{StaticResource TableHeaderLabel}"
                               HorizontalTextAlignment="End" />
                        <Label Grid.Column="4" Text="النتيجة" Style="{StaticResource TableHeaderLabel}" />
                        <BoxView Grid.ColumnSpan="5" Style="{StaticResource RowRule}" Margin="-16,0" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Completed}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ExamSummary">
                                <Grid Style="{StaticResource TableRow}"
                                      ColumnDefinitions="2.6*,1.2*,*,*,*" HeightRequest="44">

                                    <Label Grid.Column="0" Text="{Binding Title}"
                                           Style="{StaticResource CellLabel}" />
                                    <Label Grid.Column="1" Text="{Binding CourseName}"
                                           Style="{StaticResource CellLabelSecondary}" />
                                    <Label Grid.Column="2" Text="{Binding BestAttemptDateLabel}"
                                           Style="{StaticResource CellLabelNumeric}" />
                                    <Label Grid.Column="3" Text="{Binding BestScoreLabel}"
                                           Style="{StaticResource CellLabelNumeric}"
                                           HorizontalTextAlignment="End" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

                                    <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
                                        <Ellipse WidthRequest="6" HeightRequest="6" VerticalOptions="Center"
                                                 Fill="{Binding BestAttemptPassed, Converter={StaticResource VerdictInk}}" />
                                        <Label Text="{Binding BestVerdictLabel}"
                                               Style="{StaticResource PillLabel}"
                                               TextColor="{Binding BestAttemptPassed, Converter={StaticResource VerdictInk}}" />
                                    </HorizontalStackLayout>

                                    <BoxView Grid.ColumnSpan="5" Style="{StaticResource RowRule}" Margin="-16,0" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══ States, shared by both tabs ═══════════════════════════ -->
            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Exams.IsLoading}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="320" />
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="260" />
                    <Border Style="{StaticResource SkeletonLine}" WidthRequest="290" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Exams.IsEmpty}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="لا توجد اختبارات في كورساتك بعد."
                           Style="{StaticResource CellLabelSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding IsFilteredEmpty}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="لا توجد اختبارات مطابقة." Style="{StaticResource CellLabelSecondary}" />
                    <Button Text="إزالة البحث" Style="{StaticResource NeutralButton}"
                            HorizontalOptions="Center" Command="{Binding ClearSearchCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource TableCard}" IsVisible="{Binding Exams.HasError}">
                <VerticalStackLayout Style="{StaticResource StatePanel}">
                    <Label Text="{Binding Exams.ErrorMessage}"
                           Style="{StaticResource CellLabelSecondary}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="إعادة المحاولة" Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Center" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
