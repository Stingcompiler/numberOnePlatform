<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:models="clr-namespace:NumberOne.Core.Models;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="الإشعارات" Style="{StaticResource TitleLabel}" />
                <Button Grid.Column="1" Text="تعليم الكل كمقروء"
                        Command="{Binding MarkAllReadCommand}"
                        Style="{StaticResource GhostButton}" VerticalOptions="Center" />
            </Grid>

            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Notifications.IsLoading}" />
            <Label Text="لا توجد إشعارات." Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Notifications.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Notifications.HasError}">
                <Label Text="{Binding Notifications.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                       VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="16">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationGroup">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Label}" Style="{StaticResource HeadingLabel}" />
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Notification">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=MarkReadCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <!-- Unread dot in primary; hidden once read. -->
                                            <Ellipse Grid.Column="0" WidthRequest="6" HeightRequest="6"
                                                     VerticalOptions="Start" Margin="0,6,0,0"
                                                     IsVisible="{Binding IsRead, Converter={StaticResource Invert}}"
                                                     Fill="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Title}" Style="{StaticResource BodyLabel}" />
                                                <Label Text="{Binding Message}" Style="{StaticResource CopyLabel}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" VerticalOptions="Start"
                                                   Text="{Binding NotificationType, Converter={StaticResource NotificationTypeWord}}"
                                                   Style="{StaticResource MutedLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
