<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">

    <!--
        Read-only history. There is deliberately no delete action and no export:
        a student able to delete their own exam record makes the academic record
        falsifiable by the very person it grades. The backend has no endpoint for
        either, and neither should be added.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="النتائج" Style="{StaticResource TitleLabel}" />

            <!-- Performance summary -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="المحاولات" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding TotalCount}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ناجح" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding PassedCount}" Style="{StaticResource TitleLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="راسب" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding FailedCount}" Style="{StaticResource TitleLabel}"
                               TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="المعدّل" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding AveragePercent, StringFormat='{0}٪'}" Style="{StaticResource TitleLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Filters -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="الكل" Command="{Binding FilterAllCommand}" Style="{StaticResource NeutralButtonSmall}" />
                <Button Text="ناجح" Command="{Binding FilterPassedCommand}" Style="{StaticResource NeutralButtonSmall}" />
                <Button Text="راسب" Command="{Binding FilterFailedCommand}" Style="{StaticResource NeutralButtonSmall}" />
                <Border Style="{StaticResource InputShell}" HeightRequest="32" WidthRequest="220">
                    <Entry Text="{Binding Query}" Placeholder="بحث"
                           FontSize="{StaticResource FontBody}" VerticalOptions="Center"
                           BackgroundColor="Transparent" />
                </Border>
            </HorizontalStackLayout>

            <!-- Header -->
            <Grid ColumnDefinitions="2*,1.4*,1*,1*,1*" HeightRequest="36">
                <Label Grid.Column="0" Text="الاختبار" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="الكورس" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="التاريخ" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="الدرجة" Style="{StaticResource MutedLabel}" VerticalOptions="Center"
                       HorizontalTextAlignment="End" />
                <Label Grid.Column="4" Text="النتيجة" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Results.IsLoading}" />
            <Label Text="لا توجد نتائج بعد." Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Results.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Results.HasError}">
                <Label Text="{Binding Results.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                       VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Visible}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultRow">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="2*,1.4*,1*,1*,1*" HeightRequest="40">
                                <!-- The only row action: عرض التفاصيل. There is
                                     deliberately no delete and no export. -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ResultsViewModel}}, Path=OpenAttemptCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="{Binding ExamTitle}"
                                       Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding CourseName}"
                                       Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding DateLabel}"
                                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding ScoreLabel}"
                                       Style="{StaticResource BodyLabel}" VerticalOptions="Center"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="4" Text="{Binding VerdictLabel}"
                                       VerticalOptions="Center"
                                       FontSize="{StaticResource FontSecondary}"
                                       TextColor="{Binding IsPassed, Converter={StaticResource VerdictInk}}" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
