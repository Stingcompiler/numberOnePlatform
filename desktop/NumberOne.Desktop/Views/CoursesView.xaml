<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             x:Class="NumberOne.Desktop.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="الكورسات" Style="{StaticResource TitleLabel}" />

            <!-- A dense table, not a card grid. 36px header, 40px rows,
                 1px separators, no zebra. -->
            <Grid ColumnDefinitions="2.2*,1.4*,1.2*,1.2*,1.4*" HeightRequest="36">
                <Label Grid.Column="0" Text="الكورس" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="المدرّس" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="النظام" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="التقدّم" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Label Grid.Column="4" Text="المحتوى" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            </Grid>
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

            <!-- All four states. -->
            <Label Text="جارٍ التحميل…" Style="{StaticResource MutedLabel}"
                   IsVisible="{Binding Courses.IsLoading}" />
            <Label Text="لم تُفتح لك كورسات بعد." Style="{StaticResource SecondaryLabel}"
                   IsVisible="{Binding Courses.IsEmpty}" />

            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Courses.HasError}">
                <Label Text="{Binding Courses.ErrorMessage}" Style="{StaticResource SecondaryLabel}"
                       VerticalOptions="Center" />
                <Button Text="إعادة المحاولة" Command="{Binding Courses.LoadCommand}"
                        Style="{StaticResource NeutralButtonSmall}" />
            </HorizontalStackLayout>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Courses.Value}"
                                 IsVisible="{Binding Courses.HasData}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CourseRow">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="2.2*,1.4*,1.2*,1.2*,1.4*" HeightRequest="40">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoursesViewModel}}, Path=OpenCourseCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0" Text="{Binding Name}"
                                       Style="{StaticResource BodyLabel}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding TeacherName}"
                                       Style="{StaticResource SecondaryLabel}" VerticalOptions="Center" />

                                <!-- Tinted pill: blue for online, red for flash. -->
                                <Border Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Start"
                                        Padding="8,2" StrokeThickness="0" StrokeShape="RoundRectangle 9999"
                                        BackgroundColor="{Binding IsOnline, Converter={StaticResource SystemTypeTint}}">
                                    <Label Text="{Binding SystemTypeDisplay}"
                                           FontSize="{StaticResource FontLabel}"
                                           TextColor="{Binding IsOnline, Converter={StaticResource SystemTypeInk}}" />
                                </Border>

                                <Grid Grid.Column="3" VerticalOptions="Center" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Text="{Binding PercentLabel}"
                                           Style="{StaticResource MutedLabel}" />
                                    <ProgressBar Grid.Row="1" HeightRequest="4"
                                                 Progress="{Binding Percent, Converter={StaticResource PercentToFraction}}"
                                                 ProgressColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
                                </Grid>

                                <Label Grid.Column="4" Text="{Binding ContentLabel}"
                                       Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
