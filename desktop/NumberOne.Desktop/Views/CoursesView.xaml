<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NumberOne.Core.ViewModels;assembly=NumberOne.Core"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="NumberOne.Desktop.Views.CoursesView"
             x:Name="Root"
             x:DataType="vm:CoursesViewModel">

    <!--
        كورساتي — one dense table, not a card grid.

        Six columns: الكورس / المدرّس / النظام / التقدّم / المحتوى / فتح. A card
        grid would show four courses where this shows twelve, and a student
        comparing progress across subjects is scanning a column, not browsing.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label Grid.Column="0" Text="كورساتي" Style="{StaticResource HeadingLabel}" />
                <BoxView Grid.Column="1" Style="{StaticResource SectionRule}" />
            </Grid>

            <Border Style="{StaticResource TableCard}">
                <VerticalStackLayout>

                    <!-- Column heads. Hidden while there is nothing under them:
                         a header row over an empty-state panel reads as a table
                         that failed rather than one with no rows. -->
                    <Grid Style="{StaticResource TableHeaderRow}"
                          ColumnDefinitions="1.8*,1.2*,*,1.6*,*,72"
                          IsVisible="{Binding HasRows}">
                        <Label Grid.Column="0" Text="الكورس" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="1" Text="المدرّس" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="2" Text="النظام" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="3" Text="التقدّم" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="4" Text="المحتوى" Style="{StaticResource TableHeaderLabel}" />
                        <Label Grid.Column="5" Text="فتح" Style="{StaticResource TableHeaderLabel}"
                               HorizontalTextAlignment="Center" />
                        <BoxView Grid.ColumnSpan="6" Style="{StaticResource RowRule}" Margin="-16,0" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Visible}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CourseRow">
                                <Grid Style="{StaticResource TableRow}"
                                      ColumnDefinitions="1.8*,1.2*,*,1.6*,*,72"
                                      HeightRequest="48">

                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           Style="{StaticResource CellLabelStrong}" />

                                    <Label Grid.Column="1" Text="{Binding TeacherName}"
                                           Style="{StaticResource CellLabelSecondary}" />

                                    <!-- Blue for online, red-tinted for flash.
                                         A tint, never a filled block: red is the
                                         brand colour here as well as the danger
                                         one, and a solid red chip in a row reads
                                         as an error. -->
                                    <Border Grid.Column="2" Style="{StaticResource Pill}"
                                            BackgroundColor="{Binding IsOnline, Converter={StaticResource SystemTypeTint}}">
                                        <Label Text="{Binding SystemTypeDisplay}"
                                               Style="{StaticResource PillLabel}"
                                               TextColor="{Binding IsOnline, Converter={StaticResource SystemTypeInk}}" />
                                    </Border>

                                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Border Grid.Column="0" Style="{StaticResource ProgressTrack}">
                                            <ProgressBar HeightRequest="4" BackgroundColor="Transparent"
                                                         Progress="{Binding Fraction}"
                                                         ProgressColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding PercentLabel}"
                                               Style="{StaticResource CellLabelNumeric}" />
                                    </Grid>

                                    <Label Grid.Column="4" Text="{Binding ContentLabel}"
                                           Style="{StaticResource CellLabelSecondary}" />

                                    <!-- A chevron, not a button: the whole row
                                         is the target, and a button inside it
                                         would give two hit areas for one act. -->
                                    <shapes:Path Grid.Column="5" Style="{StaticResource IconPathMuted}"
                                                 WidthRequest="14" HeightRequest="14"
                                                 StrokeThickness="2"
                                                 Data="{StaticResource IconChevronLeft}" />

                                    <BoxView Grid.ColumnSpan="6" Style="{StaticResource RowRule}" Margin="-16,0" />

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCourseCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ── Loading ───────────────────────────────────────── -->
                    <VerticalStackLayout IsVisible="{Binding Courses.IsLoading}">
                        <Grid HeightRequest="48" Padding="16,0"
                              ColumnDefinitions="1.8*,1.2*,*,1.6*,*,72" ColumnSpacing="16">
                            <Border Grid.Column="0" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="3" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="4" Style="{StaticResource SkeletonLine}" />
                            <BoxView Grid.ColumnSpan="6" Style="{StaticResource RowRule}" Margin="-16,0" />
                        </Grid>
                        <Grid HeightRequest="48" Padding="16,0"
                              ColumnDefinitions="1.8*,1.2*,*,1.6*,*,72" ColumnSpacing="16">
                            <Border Grid.Column="0" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="3" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="4" Style="{StaticResource SkeletonLine}" />
                            <BoxView Grid.ColumnSpan="6" Style="{StaticResource RowRule}" Margin="-16,0" />
                        </Grid>
                        <Grid HeightRequest="48" Padding="16,0"
                              ColumnDefinitions="1.8*,1.2*,*,1.6*,*,72" ColumnSpacing="16">
                            <Border Grid.Column="0" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="1" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="2" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="3" Style="{StaticResource SkeletonLine}" />
                            <Border Grid.Column="4" Style="{StaticResource SkeletonLine}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- ── Nothing enrolled ──────────────────────────────── -->
                    <!--
                        Distinct from "nothing matched the search". This one is
                        the school's to fix, so it names the remedy rather than
                        offering a control that would not help.
                    -->
                    <VerticalStackLayout Style="{StaticResource StatePanel}"
                                         IsVisible="{Binding Courses.IsEmpty}">
                        <Label Text="لم تُفتح لك كورسات بعد."
                               Style="{StaticResource CellLabelSecondary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="إن كنت قد سدّدت اشتراكك، راجع إدارة المدرسة لتفعيل كورساتك."
                               Style="{StaticResource CopyLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- ── Nothing matched ───────────────────────────────── -->
                    <VerticalStackLayout Style="{StaticResource StatePanel}"
                                         IsVisible="{Binding IsFilteredEmpty}">
                        <Label Text="لا توجد كورسات مطابقة للبحث."
                               Style="{StaticResource CellLabelSecondary}" />
                        <Button Text="إزالة البحث" Style="{StaticResource NeutralButton}"
                                HorizontalOptions="Center"
                                Command="{Binding ClearSearchCommand}" />
                    </VerticalStackLayout>

                    <!-- ── Failed ────────────────────────────────────────── -->
                    <VerticalStackLayout Style="{StaticResource StatePanel}"
                                         IsVisible="{Binding Courses.HasError}">
                        <Label Text="{Binding Courses.ErrorMessage}"
                               Style="{StaticResource CellLabelSecondary}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="إعادة المحاولة" Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Center"
                                Command="{Binding LoadCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
