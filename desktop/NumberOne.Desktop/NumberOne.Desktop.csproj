<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Stops the XAML-generated handler intercepting every unhandled exception
			with Debugger.Break().

			That break fires BEFORE our own UnhandledException handler, so under a
			debugger the app halts on a generated line with no message and the crash
			log is never written — and with no debugger attached it does nothing at
			all and the window simply closes. Either way the fault is invisible,
			which is how the same crash was reported three times with nothing
			attached to it.

			With this defined, Platforms/Windows/App.xaml.cs handles it: the
			exception is written to crash.log and shown on screen.
		-->
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>

		<!--
			Desktop only. No Linux target exists for MAUI.

			The Windows TFM is listed FIRST on Windows deliberately: Visual Studio
			runs whichever target framework leads this list, and with maccatalyst
			first, F5 tries to launch a Mac app on Windows and dies looking for
			hostpolicy.dll. Order here is the difference between F5 working and a
			confusing fatal error.
		-->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>NumberOne.Desktop</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>مدارس ومعاهد نمبر ون</ApplicationTitle>
		<ApplicationId>com.numberoneschools.desktop</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) needs Windows 10 2004 (19041).
		     Targeting it here rather than 17763 keeps the API available without a runtime
		     version guard on every call site; the guard in WindowProtection stays anyway,
		     because a user on an older build must still get a working app minus that layer. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!--
			The school's own mark, not the template's.

			These shipped as the stock .NET assets: a purple square with the bot
			on it, and a splash byte-identical to that same bot. Only the icon's
			background colour had ever been changed, so the app announced itself
			in the taskbar, the Start menu and Alt-Tab as a .NET sample.

			One image each, no ForegroundFile: the logo is a complete mark with
			its own ground, and splitting it into a tinted background plus an
			overlay would only give the compositor a chance to crop the brush
			ring.
		-->
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*.ttf" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NumberOne.Core\NumberOne.Core.csproj" />
	</ItemGroup>

</Project>
