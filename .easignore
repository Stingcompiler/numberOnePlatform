# ما لا يُرفع إلى EAS Build.
#
# EAS يؤرشف جذر المستودع لا مجلد التطبيق، وهذا المستودع يضمّ ثلاثة مشاريع
# أخرى. أوّل محاولة بناء رفعت ٢٫٦ جيجابايت وفشلت عند حدّ ٢٫٠ — أكثرها مخرجات
# بناء لا علاقة لها بتطبيق الهاتف إطلاقاً.
#
# وجودُ هذا الملف يُلغي اعتماد EAS على .gitignore، فكل ما يجب استبعاده يُذكر
# هنا صراحةً — بما فيه node_modules التي كانت مستبعدة تلقائياً قبله.
#
# ومكانه جذرُ المستودع لا mobile/. وُضع هناك أولاً فلم يتغيّر حجم الأرشيف
# بايتاً واحداً — ٢٫٦ ج.ب قبله وبعده — لأن جذر الأرشيف هو جذر المستودع لا
# مجلد التطبيق، وهناك يُبحث عن هذا الملف.

# ── المشاريع الشقيقة ─────────────────────────────────────────────────────
# تطبيق سطح المكتب بنسختيه، ولوحة الإدارة، والخادم.
/desktop
/desktop-tauri
/frontend
/backend

# ── مخرجات البناء، أينما وُجدت ───────────────────────────────────────────
node_modules/
target/
dist/
build/
bin/
obj/
.expo/
.next/
__pycache__/

# مخرجات أندرويد وiOS المحلية: EAS يبنيها من جديد على خادمه.
android/build/
android/app/build/
android/.gradle/
android/.cxx/
ios/build/
ios/Pods/

# ── ما لا يخصّ البناء ────────────────────────────────────────────────────
.git/
*.log
*.keystore
*.jks
.env
.env.*
